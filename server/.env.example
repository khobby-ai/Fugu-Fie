# Copy to .env in the server/ folder.

PORT=4000

# From dashboard.paystack.com -> Settings -> API Keys & Webhooks
# Test keys work immediately with no approval wait; switch to live keys
# once you're ready to accept real money (Paystack does a quick business
# verification for that step, separate from getting started).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

CLIENT_ORIGIN=http://localhost:5173

# --- WhatsApp order notifications, via CallMeBot (free for personal use) ---
# Setup: save +34 644 59 71 65 as a contact on WHATSAPP (not Signal), message it
# exactly: "I allow callmebot to send me messages", then wait for its reply —
# it contains your personal apikey. Full details: callmebot.com/blog/free-api-whatsapp-messages
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
