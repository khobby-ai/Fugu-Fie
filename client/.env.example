# Copy to .env in the client/ folder.

# Leave blank for local development (defaults to http://localhost:4000/api).
# Once the backend is deployed, set this to its live URL + /api,
# e.g. https://fugu-fie-api.onrender.com/api
VITE_API_BASE=

# Your WhatsApp number, in international format with no + or spaces
# (e.g. Ghana number 024 123 4567 becomes 233241234567).
# Used to build the "chat with us" link on the custom smock request page.
VITE_WHATSAPP_NUMBER=
